{
  "name": "yomu-pace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "日本語の意味のまとまりを保ちながら、一定のペースで読めるローカルファースト読書支援アプリ",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
