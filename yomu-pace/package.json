    "check": "npm run test && npm run build"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "budoux": "0.8.4",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "marked": "18.0.7"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
